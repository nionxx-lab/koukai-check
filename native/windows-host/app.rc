// 専用ウィンドウのリソース（アイコン・マニフェスト・バージョン情報）。scripts/build-windows-exe.mjs が windres で使う。
#pragma code_page(65001)
#include <winver.h>

1 ICON "icon.ico"
// マニフェスト（app.manifest）はここでは入れない。リンクのあとで scripts/build-windows-exe.mjs が1つだけ入れる。
// MinGW-w64 の gcc は既定のマニフェスト（default-manifest.o）を必ずリンクし、配布によっては重複したまま残るため

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "FileDescription", "公開前チェック（画面）"
      VALUE "ProductName", "公開前チェック"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductVersion", "0.2.0"
      VALUE "InternalName", "koukai-check-window"
      VALUE "OriginalFilename", "koukai-check-window.exe"
      VALUE "CompanyName", "nionxx-lab"
      VALUE "LegalCopyright", "Copyright (c) 2026 nionxx-lab. PolyForm Shield License 1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0411, 1200
  END
END
